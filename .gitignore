# ---- data ----------------------------------------------------------------
# The Kaggle CSV is 144MB — too big for git. Keep it local; README says where
# to put it. The generated synthetic surrogate is reproducible, so ignore it too.
data/transactions/creditcard.csv
data/transactions/creditcard_SYNTHETIC.csv
data/transactions/*.csv
# The knowledge base IS committed (it's small and reproducible but handy to have
# in the repo). If you'd rather regenerate it, un-ignore is not needed — it's
# tracked by default. To exclude it instead, uncomment:
# data/knowledge_base/*.txt

# ---- model artifacts -----------------------------------------------------
# Regenerated by `python ml/train.py`. The .joblib can be large and is not
# source. metrics.json is small; keep it if you want the numbers in the repo,
# otherwise it regenerates too.
ml/artifacts/*.joblib
# ml/artifacts/metrics.json          # uncomment to also ignore saved metrics

# ---- secrets -------------------------------------------------------------
# NEVER commit the Gemini key. Use an env var or a git-ignored .env file.
.env
.env.*
*.key
secrets.*

# ---- python --------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- virtual environments ------------------------------------------------
.venv/
.venv-ragas/
venv/
env/

# ---- caches from optional deps -------------------------------------------
# sentence-transformers / HuggingFace weights cache (large, re-downloadable)
.cache/
*.faiss

# ---- OS / editor ---------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
